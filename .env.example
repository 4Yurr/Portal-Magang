# ============================================================
# APLIKASI MAGANG BPJS KETENAGAKERJAAN
# File contoh environment. Salin ke `.env` lalu isi nilai.
# ============================================================

# URL proyek Supabase Anda (dari Dashboard Supabase -> Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public anon key (aman untuk frontend)
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ------------------------------------------------------------------
# PENTING KEAMANAN:
# - JANGAN pernah memasukkan SUPABASE_SERVICE_ROLE_KEY ke frontend.
# - Frontend HANYA memakai VITE_SUPABASE_URL dan VITE_SUPABASE_ANON_KEY.
# - Service role key, jika diperlukan, hanya dipakai server-side.
# ------------------------------------------------------------------
